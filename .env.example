# ==============================================================================
# Pariksha - Environment Configuration Example
# Copy this file to .env and customize values for your local environment
# ==============================================================================

# General Django Settings
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SETTINGS_MODULE=config.settings.development

# Database Configuration
# In development, leave empty or set to False to use SQLite
USE_POSTGRES=False
DB_NAME=pariksha_db
DB_USER=pariksha_user
DB_PASSWORD=pariksha_secure_password
DB_HOST=localhost
DB_PORT=5432

# Google OAuth2 Credentials (django-allauth)
# Obtain these from the Google Cloud Console (APIs & Services > Credentials)
# Authorized redirect URI: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Security Settings (Production Only)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Media & Storage Settings
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg

# Future AI Backend Configuration (Unconnected Integration Boundary)
# Set these when the AI Model and inference microservice are deployed in the future
FUTURE_AI_SERVICE_URL=http://localhost:8080/v1/assistant
FUTURE_AI_SERVICE_API_KEY=
